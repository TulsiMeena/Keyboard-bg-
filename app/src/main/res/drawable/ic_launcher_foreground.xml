<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing keyboard frame outline -->
    <path
        android:pathData="M30,34 h48 a6,6 0 0,1 6,6 v28 a6,6 0 0,1 -6,6 h-48 a6,6 0 0,1 -6,-6 v-28 a6,6 0 0,1 6,-6 z"
        android:strokeWidth="2.5"
        android:strokeColor="#6366F1"
        android:fillColor="#1A6366F1" />

    <!-- Top row keys -->
    <path
        android:pathData="M34,40 h8 v6 h-8 z M46,40 h8 v6 h-8 z M58,40 h8 v6 h-8 z M70,40 h4 v6 h-4 z"
        android:fillColor="#818CF8" />

    <!-- Middle row keys -->
    <path
        android:pathData="M36,50 h8 v6 h-8 z M48,50 h8 v6 h-8 z M60,50 h8 v6 h-8 z M72,50 h2 v6 h-2 z"
        android:fillColor="#A5B4FC" />

    <!-- Space bar with motion wave gradient -->
    <path
        android:pathData="M42,60 h24 a2,2 0 0,1 2,2 v2 a2,2 0 0,1 -2,2 h-24 a2,2 0 0,1 -2,-2 v-2 a2,2 0 0,1 2,-2 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="60"
                android:endX="70"
                android:endY="66"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#A855F7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing play / motion indicator -->
    <path
        android:pathData="M52,49 L58,53 L52,57 Z"
        android:fillColor="#F43F5E" />

</vector>
